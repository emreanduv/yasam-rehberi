    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
